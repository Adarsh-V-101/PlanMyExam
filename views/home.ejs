<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Plan My Exam</title>
    <link rel="stylesheet" href="/css/style.css" />
    <style>
      
    </style>
  </head>
  <body>
    <div class="dashboard">
      <a href="/dashboard">Dashboard</a>
    </div>
    <div class="container">
      <h1>Enter Subject and Deadlines</h1>
      <form id="deadline-form" method="post">
        <div class="form-group">
          <label for="subject-name">Subject Name</label>
          <input
            type="text"
            id="subject-name"
            name="subject-name"
            placeholder="e.g. Biology"
            required
          />
        </div>
        <div class="form-group">
          <label for="exam-goal">Exam / Goal</label>
          <input
            type="text"
            id="exam-goal"
            name="exam-goal"
            placeholder="e.g. Final exam, quiz, certification"
            required
          />
        </div>
        <div class="form-group">
          <label for="hours-per-day">Hours Per Day</label>
          <input
            type="number"
            id="hours-per-day"
            name="hours-per-day"
            min="0"
            step="0.5"
            placeholder="e.g. 2"
            required
          />
        </div>
         
        <div class="form-group">
          <label for="deadline-description">Deadline Description</label>
          <textarea
            id="deadline-description"
            name="deadline-description"
            placeholder="e.g. Final exam project, assignment submission"
            required
          ></textarea>
        </div>
        <div class="form-group">
          <label for="deadline-date">Deadline Date</label>
          <input type="date" id="deadline-date" name="deadline-date" required />
        </div>
        <button type="submit">Save Deadline</button>
      </form>
      <div
        class="container"
        id="deadline-list-container"
        style="margin-top: 20px"
      >
        <h2>Saved Deadlines</h2>
        <ul
          id="deadline-list"
          style="list-style: none; padding: 0; margin: 0"
        ></ul>
      </div>
    </div>

    <div class="loading-popup" id="loading-popup">
      <div class="loading-popup__content">
        <div class="loading-popup__spinner"></div>
        <p class="loading-popup__message">Saving deadline, please wait...</p>
      </div>
    </div>

    <div class="popup" id="popup"></div>
    
    <script src="/js/script.js"></script>
  </body>
</html>
