<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Enter Email for OTP</title>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f7fb;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
      }
      .card {
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        width: 320px;
      }
      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
      }
      input {
        width: 100%;
        padding: 10px;
        border: 1px solid #d7dfe9;
        border-radius: 4px;
        margin-bottom: 12px;
      }
      button {
        width: 100%;
        padding: 10px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      .note {
        font-size: 13px;
        color: #555;
        margin-top: 10px;
        text-align: center;
      }
      #otp,
      #otpLabel {
        display: none;
        width: 100%;
        padding: 10px;
        border: 1px solid #d7dfe9;
        border-radius: 4px;
        margin-bottom: 12px;
      }
      #btn2 {
        display: none;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h2 style="margin: 0 0 12px 0">Sign in with Email</h2>
      <form id="form" method="post">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter your name"
          required
          autofocus
        />
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
          autofocus
        />
        <label id="otpLabel" for="otp">OTP</label>
        <input
          id="otp"
          name="otp"
          type="text"
          placeholder="Enter OTP"
          autofocus
        />
        <button type="submit" id="btn1">Send OTP</button>
        <button type="submit" id="btn2">Verify OTP</button>
      </form>
      <div class="note">
        An OTP (one-time password) will be sent to your email.
      </div>
    </div>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script>
    emailjs.init("ewZ5mSAWuSxb24NdM");
    var otp = null;

    const emailInput = document.getElementById("email");
    const emailForm = document.getElementById("form");
    const otpInput = document.getElementById("otp");
    const btn1 = document.getElementById("btn1");
    const btn2 = document.getElementById("btn2");

    otp = generateOTP();
    emailForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      console.log(emailInput.value);
      const templateParams = {
        email: emailInput.value,
        otp: otp,
      };
      try {
        await emailjs.send(
          "service_ndv8amq",
          "template_qlsb9ij",
          templateParams,
        );
        console.log("OTP sent successfully");
      } catch (err) {
        console.error("Failed to send OTP:", err);
        alert("Failed to send OTP. Please try again.");
      }
      emailInput.setAttribute("readonly", true);
      otpInput.style.display = "block";
      document.getElementById("otpLabel").style.display = "block";
      btn1.style.display = "none";
      btn2.style.display = "block";
    });

    function generateOTP() {
      const otp = Math.floor(Math.random() * 1000000).toString();
      return otp;
    }
    
    btn2.addEventListener("click",(e)=>{
      e.preventDefault();
      console.log("Generated OTP:", otp);
      if(otpInput.value == otp){
        form.setAttribute("action","/login");
        form.submit();
      } else {
        alert("Invalid OTP. Please try again.");
      }
    });
  </script>
</html>
