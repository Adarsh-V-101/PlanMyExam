<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In — PlanMyExam</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>

    <div class="login-wrap">

      <div class="login-brand">
        <div class="login-brand__name">
          <span class="glow-dot"></span>
          PlanMyExam
        </div>
        <p class="login-brand__tagline">AI-powered study planning for exams that matter.</p>
      </div>

      <div class="login-card">
        <h2>Sign in</h2>

        <form id="form" method="post" class="login-form">

          <div class="form-group">
            <label for="name">Your name</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="e.g. Adarsh"
              required
              autofocus
            />
          </div>

          <div class="form-group">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
            />
          </div>

          <!-- OTP field — hidden until email is sent -->
          <div class="form-group otp-group" id="otp-group">
            <label for="otp">One-time password</label>
            <input
              id="otp"
              name="otp"
              type="text"
              placeholder="6-digit code"
              autocomplete="one-time-code"
              inputmode="numeric"
            />
          </div>

          <button type="submit" id="btn1" class="btn btn-primary btn-login">
            Send OTP →
          </button>
          <button type="submit" id="btn2" class="btn btn-primary btn-login" style="display:none;">
            Verify &amp; Sign In →
          </button>

        </form>

        <p class="login-note" id="login-note">
          An OTP will be sent to your email address.
        </p>
      </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script>
      emailjs.init("ewZ5mSAWuSxb24NdM");

      var otp = generateOTP(); // generate once on page load

      const nameInput  = document.getElementById("name");
      const emailInput = document.getElementById("email");
      const emailForm  = document.getElementById("form");
      const otpInput   = document.getElementById("otp");
      const otpGroup   = document.getElementById("otp-group");
      const btn1       = document.getElementById("btn1");
      const btn2       = document.getElementById("btn2");
      const note       = document.getElementById("login-note");

      // Step 1 — send OTP
      emailForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        btn1.textContent = "Sending…";
        btn1.disabled = true;

        const templateParams = {
          email: emailInput.value,
          otp: otp,
        };

        try {
          await emailjs.send("service_ndv8amq", "template_qlsb9ij", templateParams);
          // Lock name + email fields
          nameInput.setAttribute("readonly", true);
          emailInput.setAttribute("readonly", true);
          // Reveal OTP input and switch buttons
          otpGroup.style.display = "grid";
          btn1.style.display = "none";
          btn2.style.display = "flex";
          // Update note
          note.textContent = "✓ OTP sent — check your inbox.";
          note.className = "login-note sent";
          otpInput.focus();
        } catch (err) {
          console.error("Failed to send OTP:", err);
          btn1.textContent = "Send OTP →";
          btn1.disabled = false;
          note.textContent = "Could not send OTP. Please try again.";
          note.className = "login-note error";
        }
      });

      // Step 2 — verify OTP
      btn2.addEventListener("click", (e) => {
        e.preventDefault();
        if (otpInput.value.trim() === otp) {
          emailForm.setAttribute("action", "/login");
          emailForm.submit();
        } else {
          note.textContent = "Incorrect OTP — check your email and try again.";
          note.className = "login-note error";
          otpInput.value = "";
          otpInput.focus();
        }
      });

      // Always produces a 6-digit string (100000–999999)
      function generateOTP() {
        return Math.floor(100000 + Math.random() * 900000).toString();
      }
    </script>
  </body>
</html>
