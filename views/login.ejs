<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Enter Email for OTP</title>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f7fb;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
      }
      .card {
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        width: 320px;
      }
      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
      }
      input[type="email"] {
        width: 100%;
        padding: 10px;
        border: 1px solid #d7dfe9;
        border-radius: 4px;
        margin-bottom: 12px;
      }
      button {
        width: 100%;
        padding: 10px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      .note {
        font-size: 13px;
        color: #555;
        margin-top: 10px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h2 style="margin: 0 0 12px 0">Sign in with Email</h2>
      <form action="/send-otp" method="post">
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
          autofocus
        />
        <button type="submit">Send OTP</button>
      </form>
      <div class="note">
        An OTP (one-time password) will be sent to your email.
      </div>
    </div>
  </body>
</html>
